<div class="container-fluid">
    <div class="row mt-5">
        <div class="col-6">
            <div class="row">
                <div class="col">
                    {{{renderform}}}
                </div>
            </div>
            <div class="row mt-5">
                <div class="col">
                    <p class="alert alert-secondary">
                        <b>{{#str}} review:accesstype, eportfolioplugins_hub {{/str}}: </b>{{accesstype}}<br><br>
                        <b>{{#str}} review:approval, eportfolioplugins_hub {{/str}}: </b>{{approvalprocess}}<br><br>
                        <b>{{#str}} review:status, eportfolioplugins_hub {{/str}}: </b>{{status}}<br>
                        <b>{{#str}} review:title, eportfolioplugins_hub {{/str}}: </b>{{title}}<br>
                        <b>{{#str}} review:usermodified, eportfolioplugins_hub {{/str}}: </b>{{usermodified}}<br>
                        <b>{{#str}} review:timecreated, eportfolioplugins_hub {{/str}}: </b>{{timecreated}}<br>
                        <b>{{#str}} review:timemodified, eportfolioplugins_hub {{/str}}: </b>{{timemodified}}
                    </p>
                </div>
            </div>
        </div>
        <div class="col-6">
            {{{h5pplayer}}}
        </div>
    </div>
</div>
