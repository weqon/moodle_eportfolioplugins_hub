<div class="row mb-5">
    <div class="col-12 pt-1">
        <div class="d-flex align-items-center">
            <h1 class="mb-0">
                {{title}}
            </h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="col">
        {{#backurl}}
            <a href="{{backurl}}" class="btn btn-primary" title="{{backurlstring}}">
                {{#pix}} t/left, core, {{backurlstring}}{{/pix}}
                {{backurlstring}}
            </a>
        {{/backurl}}
    </div>
</div>

<div class="divider"></div>

<div class="row">
    <div class="col-lg-8">
        {{{h5pplayer}}}
    </div>
    <div class="col-lg-4 pt-3">
        <div class="alert alert-secondary">
            <p>
                <b>{{#str}} hub:overview:description, eportfolioplugins_hub {{/str}}: </b><br>{{description}}
            </p>
            <hr class="divider mt-5">
            <p>
                <b>{{#str}} hub:overview:publishedby, eportfolioplugins_hub {{/str}}: </b>{{publishedby}}<br>
                <b>{{#str}} hub:overview:timecreated, eportfolioplugins_hub {{/str}}: </b>{{timecreated}}<br>
                <b>{{#str}} hub:overview:timemodified, eportfolioplugins_hub {{/str}}: </b>{{timemodified}}<br>
                <b>{{#str}} hub:overview:access, eportfolioplugins_hub {{/str}}: </b>{{{access}}}<br>
            </p>
        </div>

    </div>
</div>