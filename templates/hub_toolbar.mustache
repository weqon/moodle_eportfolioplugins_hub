{{!
    @template local_eportfolio/share

    Template purpose and description.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}

<div class="row mt-5 mb-5">
    <div class="col">
        <form class="d-flex flex-wrap align-items-center gap-2" method="get" action="">
            <div class="input-group me-3" style="width: auto; min-width: 220px; max-width: 340px; flex: 1;">
                <input type="text"
                       id="hub-search"
                       name="search"
                       class="form-control"
                       placeholder="{{placeholder}}"
                       {{#searchvalue}}value="{{searchvalue}}"{{/searchvalue}}>
            </div>

            <select id="hub-filter" name="filter" class="custom-select me-3">
                {{#filteroptions}}
                    <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
                {{/filteroptions}}
            </select>

            <button type="submit" class="btn btn-primary">
                {{#pix}} i/search, core {{/pix}} {{#str}}hub:overview:search:keyword, eportfolioplugins_hub{{/str}}
            </button>

            {{#reseturl}}
                <a href="{{reseturl}}" class="ms-3 btn btn-link">
                    {{#pix}} e/cancel, core {{/pix}}{{#str}}hub:overview:search:reset, eportfolioplugins_hub{{/str}}
                </a>
            {{/reseturl}}
        </form>
    </div>
</div>
